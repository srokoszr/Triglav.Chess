    <None Remove="Assets\CBurnett\Chess_pdt45.svg" />
    <None Remove="Assets\CBurnett\Chess_plt45.svg" />
    <None Remove="Assets\CBurnett\Chess_qdt45.svg" />
    <None Remove="Assets\CBurnett\Chess_qlt45.svg" />
    <None Remove="Assets\CBurnett\Chess_rdt45.svg" />
    <None Remove="Assets\CBurnett\Chess_rlt45.svg" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\CBurnett\Chess_bdt45.svg" />
