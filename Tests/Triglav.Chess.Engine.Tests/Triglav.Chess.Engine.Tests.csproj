<Project Sdk="MSTest.Sdk/4.1.0">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!--
      Displays error on console in addition to the log file. Note that this feature comes with a performance impact.
      For more information, visit https://learn.microsoft.com/dotnet/core/testing/unit-testing-platform-integration-dotnet-test#show-failure-per-test
      -->
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Triglav.Chess.Engine\Triglav.Chess.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.NET.Test.Sdk" Version="18.3.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Testing.Extensions.CodeCoverage" Version="18.5.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Testing.Extensions.TrxReport" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="MSTest.Analyzers" Version="4.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="MSTest.TestAdapter" Version="4.1.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="MSTest.TestFramework" Version="4.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../Benchmarks/Shared/MinMaxComparisonCases.cs" Link="Comparison/MinMaxComparisonCases.cs" />
    <Compile Include="../../Benchmarks/Shared/AlgorithmBenchmarkCase.cs" Link="Comparison/AlgorithmBenchmarkCase.cs" />
    <Compile Include="../../Benchmarks/Shared/Rc5GamePositions.cs" Link="Comparison/Rc5GamePositions.cs" />
    <Compile Include="../../App/Triglav.Chess.App.GUI/Model/UserPreferences.cs" Link="Preferences/UserPreferences.cs" />
    <Compile Include="../../App/Triglav.Chess.App.GUI/Model/AnalysisTimeline.cs" Link="Analysis/AnalysisTimeline.cs" />
    <Compile Include="../../App/Triglav.Chess.App.GUI/Model/GameOptions.cs" Link="GameOptions/GameOptions.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="TestData/BlackRc5Threefold.PGN" LogicalName="BlackRc5Threefold.PGN" />
    <EmbeddedResource Include="../../App/Triglav.Chess.App.GUI/Examples/AnalysisExample.TgGame" LogicalName="AnalysisExample.TgGame" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../App/Triglav.Chess.App.GUI/Properties/Resources.resx" LogicalName="GuiLocalizationAudit.resources" />
    <EmbeddedResource Include="../../App/Triglav.Chess.App.GUI/Properties/Resources.pl.resx" LogicalName="GuiLocalizationAudit.pl.resources" />
  </ItemGroup>
</Project>
